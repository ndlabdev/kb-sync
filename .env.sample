# Required (API_KEY is accepted as an alias)
OPENAI_API_KEY=

# Optional: pin the store after the first run; otherwise it is found/created by name
VECTOR_STORE_ID=
VECTOR_STORE_NAME=support-kb
OPENAI_MODEL=gpt-6-luna

# Source
ZENDESK_BASE_URL=https://support.optisigns.com
ZENDESK_LOCALE=en-us
# MAX_ARTICLES=40           # cap for quick local runs (disables deletion of missing articles)

# Processing
OUTPUT_DIR=articles
REPORT_DIR=runs
CHUNK_MAX_TOKENS=700
UPLOAD_WORKERS=8
DRY_RUN=false               # true = scrape/clean/chunk only, no OpenAI calls
PRUNE_DELETED=true

# Optional: publish each run's report to a secret GitHub Gist (no-login link for reviewers)
# GIST_ID is the id at the end of the gist URL; GIST_TOKEN needs the "gist" scope only.
GIST_ID=
GIST_TOKEN=
